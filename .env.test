# Test Environment Configuration
# This file is used for running tests

# ZhipuAI Configuration (use fake key for tests)
ZHIPU_API_KEY=test_key_for_unit_tests
ZHIPU_CHAT_MODEL=glm-4-flash
ZHIPU_EMBED_MODEL=embedding-3
ZHIPU_RERANK_MODEL=rerank-2

# Database (use temporary path for tests)
DATABASE_PATH=/tmp/test_db.db

# Storage (use temporary path for tests)
STORAGE_ROOT=/tmp/test_storage

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Concurrency (lower for tests)
MAX_CONCURRENT_TASKS=2
MAX_API_CONCURRENT=3

# Rate Limiting (disable for tests)
ENABLE_RATE_LIMIT=false
RATE_LIMIT_PER_HOUR=200
